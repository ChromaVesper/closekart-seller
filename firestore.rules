rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Admin Config ─────────────────────────────────────────────────────────
    // Any authenticated user can READ (needed to check isAdmin client-side).
    // Only admins with custom claim can WRITE (prevents self-promotion).
    // For MVP/capstone: also allow create if no doc exists yet (bootstrap).
    match /config/adminConfig {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // first-time bootstrap only
      allow update: if request.auth != null
                    && request.auth.token.admin == true;
      allow delete: if false;
    }

    // • Anyone (buyers/public) can READ seller data (to show listings).
    // • A seller can CREATE their own document (on signup).
    // • A seller can UPDATE their own profile — but NOT the verification fields.
    // • Only admins (identified by custom claim "admin": true) can update
    //   verificationStatus, verificationNotes, and isVerified.
    match /sellers/{userId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['isVerified'])
                    || (request.resource.data.isVerified == false
                        && request.resource.data.verificationStatus == 'Pending');

      // Seller can update their own non-verification fields
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['verificationStatus', 'isVerified', 'verificationNotes']);

      // Admins (custom claim) can update everything including verification
      allow update: if request.auth != null
                    && request.auth.token.admin == true;

      allow delete: if false;
    }

    // ── Products Collection ──────────────────────────────────────────────────
    // Buyers can only see products from verified sellers (enforced client-side,
    // but security rule ensures only authenticated sellers can write).
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    // ── Reels Collection ─────────────────────────────────────────────────────
    match /reels/{reelId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    // ── Orders Collection ────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.buyerId == request.auth.uid
                        || resource.data.sellerId == request.auth.uid);
      allow delete: if false;
    }

    // ── Users Collection (Buyers) ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;
    }
  }
}
